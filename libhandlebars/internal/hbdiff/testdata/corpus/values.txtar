-- number-literals.hbs --
{{to-str 1}}|{{to-str -1}}|{{to-str 1.0}}|{{to-str 1.5e3}}|{{to-str 007}}|{{to-str 1e2}}|{{to-str -0}}|{{to-str +5}}
-- literal-print.hbs --
{{1}}|{{1.50}}|{{-2}}|{{1e3}}|{{"s"}}|{{true}}|{{false}}|{{'q'}}
-- string-literal-escapes.hbs --
{{to-str "a\"b"}}|{{to-str 'a\'b'}}|{{to-str "a\\b"}}|{{to-str "<&>"}}|{{{to-str "<&>"}}}
