How context values print. Context numbers are float64 printed with
FormatFloat('f', -1, 64); maps print UNPRINTABLE; arrays concatenate
their elements; null and missing print nothing.
-- print.hbs --
[{{v}}]
-- print.jsonl --
{}
{"v":null}
{"v":""}
{"v":0}
{"v":-0}
{"v":"0"}
{"v":1}
{"v":1.5}
{"v":0.1}
{"v":100}
{"v":1e21}
{"v":1e-7}
{"v":123456789012345678}
{"v":9007199254740993}
{"v":9007199254740991}
{"v":-9007199254740993}
{"v":2.675}
{"v":1.10}
{"v":true}
{"v":false}
{"v":[]}
{"v":[1,2,3]}
{"v":["a",["b","c"],null,true,1.5]}
{"v":[{"k":1}]}
{"v":{}}
{"v":{"k":"v"}}
{"v":"é😀\u0000\t"}
{"v":"  "}
{"v":"line1\nline2"}
{"v":1.7976931348623157e308}
{"v":5e-324}
{"v":0.30000000000000004}
-- print-triple.hbs --
[{{{v}}}]
