-- if-includezero.hbs --
{{#if v includeZero=true}}T{{else}}F{{/if}}|{{#if 0 includeZero=true}}T{{else}}F{{/if}}|{{#if v includeZero=z}}T{{else}}F{{/if}}
-- if-includezero.jsonl --
{"v":0}
{"v":0,"z":true}
{"v":"0"}
{"v":null}
