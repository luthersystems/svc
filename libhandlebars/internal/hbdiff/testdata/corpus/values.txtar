{"v":"<b>&amp;\"'`="}
{"v":["<",">"]}
{"v":{"k":"<"}}
{"v":1e21}
-- print-amp.hbs --
[{{&v}}]
-- print-amp.jsonl --
{"v":"<b>&amp;\"'`="}
-- this-root.hbs --
[{{this}}][{{.}}]
-- this-root.jsonl --
{}
{"a":1}
null
