date-diff-month, is-after, date-add-months and the date formatters.
-- t01.hbs --
{{date-diff-month a b}}
-- t02.hbs --
{{date-diff-month b a}}
-- t03.hbs --
{{date-diff-month a "2020-01-31"}}
-- t04.hbs --
{{is-after a b}}
-- t05.hbs --
{{is-after b a}}
-- t06.hbs --
{{is-after a a}}
-- t07.hbs --
{{date-add-months a b}}
-- t08.hbs --
{{date-add-months a 1}}
-- t09.hbs --
{{date-add-months a -1}}
-- t10.hbs --
{{date-add-months a 0}}
-- t11.hbs --
{{date-add-months a 13}}
-- t12.hbs --
{{date-add-months a 1.0}}
-- t13.hbs --
{{date-add-months a "1"}}
-- t14.hbs --
{{date-add-months a (to-int b)}}
-- t15.hbs --
{{date-add-months a (to-int "12")}}
-- t16.hbs --
{{date-add-months "2020-01-31" 1}}
-- t17.hbs --
{{date-add-months "2020-02-29" 12}}
-- t18.hbs --
{{date-add-months "not-a-date" 1}}
-- t19.hbs --
{{date-beautify a}}
-- t20.hbs --
{{date-beautify b}}
-- t21.hbs --
{{date-DDMMYY-slash a}}
-- t22.hbs --
{{date-DDMMYYYY-slash a}}
-- t23.hbs --
{{date-DDMMYYYY a}}
-- t24.hbs --
{{date-beautify "2020-1-3"}}
-- t25.hbs --
{{date-DDMMYYYY "31/01/2020"}}
-- t26.hbs --
{{{date-beautify a}}}
