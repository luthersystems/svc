{{to-str "s"}}
-- t36.hbs --
{{to-str (times a b)}}
-- t37.hbs --
{{to-str (len a)}}
-- t38.hbs --
{{to-str (to-int a)}}
-- t39.hbs --
{{round-to-nth a b}}
-- t40.hbs --
{{round-to-nth a 2}}
